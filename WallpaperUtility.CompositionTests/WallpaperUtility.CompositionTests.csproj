<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
  </PropertyGroup>

  <!-- Compile the composition component directly: no app reference, no test framework packages. -->
  <ItemGroup>
    <Compile Include="..\WallpaperUtility\Composition\*.cs" Link="Composition\%(Filename)%(Extension)" />
    <Compile Include="..\WallpaperUtility\WallpaperImage.cs" Link="WallpaperImage.cs" />
  </ItemGroup>

</Project>
