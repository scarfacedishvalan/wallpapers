<Window x:Class="WallpaperUtility.PreviewWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Collage preview" Height="720" Width="1100" MinHeight="420" MinWidth="640"
        WindowStartupLocation="CenterOwner" Loaded="WindowLoaded" Closing="WindowClosing">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <TextBlock x:Name="SummaryText" Text="Analysing photos..." TextWrapping="Wrap" Margin="0,0,0,10"
                   AutomationProperties.AutomationId="PreviewSummary"/>
        <Border Grid.Row="1" BorderBrush="Gray" BorderThickness="1" Background="Black">
            <Image x:Name="PreviewImage" Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality"
                   AutomationProperties.AutomationId="PreviewImage"/>
        </Border>
        <TextBlock x:Name="PageText" Grid.Row="2" TextWrapping="Wrap" Margin="0,10,0,0"
                   AutomationProperties.AutomationId="PreviewPage" AutomationProperties.LiveSetting="Polite"/>
        <StackPanel Grid.Row="3" Orientation="Horizontal" Margin="0,10,0,0">
            <Button x:Name="PreviousButton" Content="_Previous" Padding="14,7" IsEnabled="False"
                    AutomationProperties.AutomationId="PreviewPrevious" Click="PreviousClicked"/>
            <Button x:Name="NextButton" Content="_Next" Padding="14,7" Margin="8,0,0,0" IsEnabled="False"
                    AutomationProperties.AutomationId="PreviewNext" Click="NextClicked"/>
            <Button x:Name="ApplyButton" Content="_Apply this wallpaper" Padding="14,7" Margin="24,0,0,0"
                    IsEnabled="False" AutomationProperties.AutomationId="PreviewApply" Click="ApplyClicked"/>
            <Button Content="_Close" Padding="14,7" Margin="8,0,0,0" IsCancel="True" Click="CloseClicked"/>
        </StackPanel>
    </Grid>
</Window>
